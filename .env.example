# Supabase project settings > API. Both values are public by design: they are
# inlined into the static bundle, and Row Level Security is what protects the
# data. Never add the secret/service-role key to this project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
